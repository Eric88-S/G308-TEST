<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cmake_utils</name>
  <version>0.0.0</version>
  <description>
    CMake utility modules for finding Eigen, GSL, etc.
    Once you use this package, you do not need to copy cmake files among packages.
  </description>

  <maintainer email="william.wu@dji.com">William.Wu</maintainer>

  <license>LGPLv3</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
